# Supabase (/Neon) — gunakan Transaction pooler untuk Vercel
# postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Secret untuk token JWT (ubah, jangan dipakai default di production)
JWT_SECRET="dev-secret-change-me-in-production"

# Base URL frontend (untuk self-fetch SSR di production)
NEXT_PUBLIC_APP_URL="https://homeless-media-omega.vercel.app"

# Cloudinary (opsional — upload gambar otomatis ke Cloudinary bila terisi)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""